@{
    ViewData["Title"] = "Kayıt Ol";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head><title></title></head>
<body>
	<div class="middlebox">
		<div class="signup-container">
			<form id="signupForm" class="form-group">
				<div class="logo-container">
					<img class="logo" src="~/images/logo.png" />
				</div>
				
				<div class="mb-2">
					<label for="UserName" class="form-label">Kullanıcı Adı</label>
					<input type="text" id="UserName" name="UserName" class="form-control" />
				</div>
				<div class="mb-2">
					<label for="email" class="form-label">E-mail</label>
					<input type="text" id="email" name="email" class="form-control" />
				</div>
				<div class="mb-2">
					<label for="Password" class="form-label">Şifre</label>
					<input type="password" id="password" name="password" class="form-control" />
				</div>
				

				<button type="submit" class="btn btn-primary">Kayıt Ol</button>
				<div class="redirect">
					<p>Zaten hesapınız varsa <a href="~/auth/login"> Giriş Yap</a></p>
				</div>
				
			</form>

			<p id="errorMessage" style="color: red; display: none;">Kullanıcı adı zaten mevcut!</p>
		</div>
	</div>
	
</body>
	
</html>

@section Scripts {
	<script>


		document.addEventListener("DOMContentLoaded", function () {
		  
			const signupForm = document.getElementById('signupForm');
			if (signupForm) {
				signupForm.addEventListener('submit', async function (e) {
					e.preventDefault();
					console.log("Signup event tetiklendi!");
					const username = document.getElementById('UserName').value;
					const password = document.getElementById('password').value;
					const email = document.getElementById('email').value;

					const data = {
						UserName: username,
						Password: password,
						Email: email
					};

					try {
						const response = await fetch('http://localhost:5269/api/Auth/signup', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'Accept': 'application/json'
							},
							body: JSON.stringify(data)
						});

						if (response.ok) {
							window.location.href = '/auth/login';
						} else {
							alert('Kayıt işlemi başarısız. Kullanıcı adı zaten alınmış olabilir.');
						}
					} catch (error) {
						console.error('Kayıt sırasında hata oluştu:', error);
					}
				});
			}
		});
	</script>

}
