@{
    ViewData["Title"] = "Kayıt Ol";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head><title></title></head>
<body>
	<div class="middlebox">
		<div class="signup-container">
			<form id="signupForm" class="form-group">
				<div class="logo-container">
					<img class="logo" src="~/images/logo.png" />
				</div>
				
				<div class="mb-2">
					<label for="UserName" class="form-label">Kullanıcı Adı</label>
					<input type="text" id="UserName" name="UserName" class="form-control" />
					<div id="UserNameFeedback" class="invalid-feedback"></div>
				</div>
				<div class="mb-2">
					<label for="email" class="form-label">E-mail</label>
					<input type="text" id="email" name="email" class="form-control" />
					<div id="emailFeedback" class="invalid-feedback"></div>
				</div>
				<div class="mb-2">
					<label for="IdentityNumber" class="form-label">Tc.Kimlik Numarası</label>
					<input type="text" id="IdentityNumber" name="IdentityNumber" class="form-control"/>
					<div id="IdentityNumberFeedback" class="invalid-feedback"></div>
				</div>
				<div class="mb-2">
					<label for="Password" class="form-label">Şifre</label>
					<input type="password" id="password" name="password" class="form-control" />
					<div  id ="passwordFeedback" class="invalid-feedback"></div>
				</div>
				

				<button type="submit" class="btn btn-primary">Kayıt Ol</button>
				<div class="redirect">
					<p>Zaten hesapınız varsa <a href="~/auth/login"> Giriş Yap</a></p>
				</div>
				
			</form>

			<p id="errorMessage" style="color: red; display: none;">Kullanıcı adı zaten mevcut!</p>
		</div>
	</div>
	
</body>
	
</html>


@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const signupForm = document.getElementById('signupForm');

			// Field adlarını normalize eden yardımcı fonksiyon
			const normalizeFieldId = (fieldName) => {
				switch (fieldName.toLowerCase()) {
					case "username": return "UserName";
					case "identitynumber": return "IdentityNumber";
					case "password": return "password";
					case "email": return "email";
					default: return fieldName;
				}
			};

			if (signupForm) {
				signupForm.addEventListener('submit', async function (e) {
					e.preventDefault();

					// Önce tüm önceki hataları temizle
					const fields = ['UserName', 'password', 'IdentityNumber', 'email'];
					fields.forEach(f => {
						const input = document.getElementById(f);
						const feedback = document.getElementById(`${f}Feedback`);
						if (input) input.classList.remove("is-invalid");
						if (feedback) feedback.innerText = '';
					});

					// Form verileri
					const data = {
						UserName: document.getElementById('UserName').value,
						Password: document.getElementById('password').value,
						Email: document.getElementById('email').value,
						IdentityNumber: document.getElementById('IdentityNumber').value
					};

					try {
						const response = await fetch('http://localhost:5269/api/Auth/signup', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'Accept': 'application/json'
							},
							body: JSON.stringify(data)
						});

						const result = await response.json();

						if (response.ok) {
							window.location.href = '/auth/login';
						} else {
							// Hata detaylarını al ve alanlara dağıt
							if (result.errors) {
								Object.entries(result.errors).forEach(([field, messages]) => {
									const inputId = normalizeFieldId(field);
									const input = document.getElementById(inputId);
									const feedback = document.getElementById(`${inputId}Feedback`);

									if (input) input.classList.add("is-invalid");
									if (feedback) feedback.innerText = messages.join(', ');
								});
							} else if (result.message) {
								// Genel bir hata varsa alert göster
								alert(result.message);
							}
						}
					} catch (error) {
						console.error('Kayıt sırasında hata oluştu:', error);
					}
				});
			}
		});
	</script>
}

