
@{
    ViewData["Title"] = "Excel Import";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    var alanlar = new List<string>
    {
        "TC Kimlik Numarası","Kullanıcı Adı","E-Mail","Şifre","Kullanıcı Seviyesi"
    };
}

<p style="background-color: rgba(51,122,183,255) ; color: white">Excel Import</p>
<form id="uploadForm" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Excel Yolu:</label>
        <input type="file" name="excelFile" id="excelFile" class="form-control" />
    </div>
    <button type="button" id="uploadBtn" class="btn btn-primary">Yükle</button>

</form>

<!--Alan Eşleştirme Tablosu-->

<form method="post" action="/User/ColumnMappingResult">
    <div id="mappingSection" >
        <table class="table">
            <thead>
                <tr>
                    <th>Alan Adı</th>
                    <th>Excel Sütun Başlığı</th>
                </tr>
            </thead>
            <tbody id="mappingTableBody">
                @foreach(var alan in alanlar)
                {
                    <tr>
                        <td>@alan</td>
                        <td>
                            <select name="@(alan.Replace(" ", "") + "Column")" class="form-control excelHeaderSelect">
								<option value="">Lütfen Excel dosyası yükleyiniz</option>

							</select>
                        </td>
                    </tr>
                }
            </tbody>
         </table>
         <button type="submit" class="btn btn-success">Devam > ></button>
     </div>    

</form>

@section Scripts {
    <script>
               // "Excel'i Yükle" butonuna tıklandığında çalışacak fonksiyon
        document.getElementById("uploadBtn").addEventListener("click", function () {
            // Dosya seçme input'unu alıyoruz
            var fileInput = document.getElementById("excelFile");

            // Eğer kullanıcı dosya seçmemişse uyarı verip çıkıyoruz
            if (fileInput.files.length === 0) {
                alert("Lütfen bir dosya seçin.");
                return; // Fonksiyonu sonlandır
            }

            // FormData nesnesi oluşturuyoruz, bu dosya gönderimi için gerekli
            var formData = new FormData();
            // FormData'ya seçilen dosyayı ekliyoruz, anahtar adı "excelFile"
            formData.append("excelFile", fileInput.files[0]);

            // fetch API ile arka planda POST isteği yapıyoruz
            fetch('/User/UploadExcel', {
                method: 'POST',    // POST metodu ile veri gönderiyoruz
                body: formData     // Gönderilen veri formData nesnesi (dosya)
            })
            // İstek sonucu dönen yanıtı JSON olarak parse ediyoruz
            .then(resp => resp.json())
            .then(data => {
                // Eğer backend'den gelen cevapta success false ise hata mesajı göster
                if (!data.success) {
                    alert(data.message);
                    return; // Fonksiyonu sonlandır
                }

                // Başlıklar (headers) verisini alıyoruz, bunlar Excel dosyasındaki sütun isimleri
                let headers = data.headers;

                // Sayfadaki tüm select box'ları seçiyoruz (class = excelHeaderSelect)
                let selects = document.querySelectorAll(".excelHeaderSelect");

                // Her bir selectbox için
                selects.forEach(sel => {
                    // Önce içeriğini temizle ve ilk seçenek olarak "Seçiniz" koy
                    sel.innerHTML = '<option value="">-- Seçiniz --</option>';

                    // Excel dosyasındaki tüm başlıkları seçenek olarak ekle
                    headers.forEach(h => {
                        // Yeni bir option elementi oluştur
                        let opt = document.createElement("option");
                        opt.value = h;   // Option'un value değeri sütun adı
                        opt.text = h;    // Görünen metin olarak da sütun adı
                        // Option'u selectbox'a ekle
                        sel.appendChild(opt);
                    });
                });

                // Eşleştirme formunun bulunduğu alanı görünür yap (başta gizliydi)
                // document.getElementById("mappingSection").style.display = "block";
            });
        });

    </script>
}
